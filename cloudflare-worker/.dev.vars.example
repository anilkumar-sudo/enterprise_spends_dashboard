# Copy to .dev.vars for local live-Sheet testing. Never commit .dev.vars.
GOOGLE_SERVICE_ACCOUNT_EMAIL=service-account@your-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\nREPLACE_WITH_PRIVATE_KEY\\n-----END PRIVATE KEY-----\\n"
GOOGLE_OAUTH_CLIENT_ID=replace-with-google-web-client-id
# AUTH_DB is provided by the wrangler D1 binding after Infra provisions it.
